{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git commit*)",
      "Bash(git push*)"
    ],
    "defaultMode": "plan"
  }
}